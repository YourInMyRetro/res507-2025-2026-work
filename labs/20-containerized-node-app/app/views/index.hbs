<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QuoteBoard</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      max-width: 700px;
      margin: 2rem auto;
      padding: 0 1rem;
      background: #111;
      color: #eee;
    }

    form {
      display: grid;
      gap: .5rem;
      margin-bottom: 2rem;
    }

    input,
    textarea,
    button {
      font: inherit;
      margin-top: 0.5rem;
    }

    h1 {
      letter-spacing: .05em;
      border-bottom: 2px solid #4a9;
      padding-bottom: .5rem;
    }

    button {
      background: #4a9;
      border: 0;
      border-radius: 4px;
      padding: .5rem 1rem;
      cursor: pointer;
    }

    .quote {
      margin-bottom: 1rem;
      padding: .75rem 1rem;
      background: #1c1c1c;
      border-left: 4px solid #4a9;
      line-height: 1.5;
    }

    .quote div:last-child {
      color: #999;
      font-style: italic;
    }
  </style>
</head>

<body>
  <h1>QuoteBoard</h1>

  <form method="post" action="/quotes">
    <input name="author" placeholder="Author (optional)" />
    <textarea name="text" placeholder="Write a quote..." required></textarea>
    <button type="submit">Add quote</button>
  </form>

  {{#if quotes.length}}
  {{#each quotes}}
  <div class="quote">
    <div>{{this.text}}</div>
    <div>— {{this.author}}</div>
  </div>
  {{/each}}
  {{else}}
  <p>No quotes yet. Add the first one.</p>
  {{/if}}
</body>

</html>